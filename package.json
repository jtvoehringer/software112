{
  "name": "software112",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/check-tenant-isolation.js && node scripts/check-api-zwei-faktor.js && node scripts/check-seiten-betrieb.js && node scripts/check-schreibsperre.js && node scripts/check-schema.js && node scripts/check-a11y.js && node scripts/check-behoerden-csv.js && node scripts/check-replica.js && node scripts/check-storno.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:verify": "node scripts/lint-zusammenfassung.mjs",
    "lint:baseline": "node scripts/lint-zusammenfassung.mjs --baseline",
    "type-check": "tsc --noEmit",
    "check-tenant-isolation": "node scripts/check-tenant-isolation.js",
    "check-api-zwei-faktor": "node scripts/check-api-zwei-faktor.js",
    "check-seiten-betrieb": "node scripts/check-seiten-betrieb.js",
    "check-schreibsperre": "node scripts/check-schreibsperre.js",
    "check-behoerden-csv": "node scripts/check-behoerden-csv.js",
    "check-replica": "node scripts/check-replica.js",
    "check-storno": "node scripts/check-storno.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run -s typecheck && npm run -s lint:verify && npm run -s test:csv && npm run -s prebuild",
    "test:csv": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/tests/*.test.mjs\"",
    "test:db": "node scripts/db-tests/run.mjs",
    "test:coverage": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test-coverage-include=src/** --test \"scripts/tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:lesend": "node e2e/nur-lesen.mjs",
    "type-check:e2e": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.46.2",
    "imapflow": "*",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shpjs": "^6.2.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/nodemailer": "*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
