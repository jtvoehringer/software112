# ─────────────────────────────────────────────────────────────────────────────
# software:112 – Umgebungsvariablen
# Kopiere diese Datei zu .env.local und trage deine Werte ein.
# .env.local wird NICHT ins Git committed (steht in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase – findest du in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN_PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein_anon_key_hier

# Supabase Service Role Key (nur serverseitig verwenden, NIE im Browser!)
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=dein_service_role_key_hier

# App URL (lokal: http://localhost:3000, Produktion: https://software112.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
