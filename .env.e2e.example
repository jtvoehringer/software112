# ── Vorlage für .env.e2e (Playwright-Regressionstests) ─────────────────────────
# Kopieren nach .env.e2e (gitignored) und ausfüllen. NIE echte Werte in diese Datei.
# Gesetzte Umgebungsvariablen (z. B. GitHub-Secrets) haben Vorrang vor .env.e2e.
# Details: e2e/README.md

# Ziel – Standard http://localhost:3000. NIE die Produktion für schreibende Tests.
E2E_BASE_URL=http://localhost:3000
# Supabase-Projekt der getesteten App (Pflicht bei entfernter Basis-URL; lokal sonst aus .env.local)
# E2E_SUPABASE_URL=https://<test-projekt-ref>.supabase.co
# 1 = nur Tests mit @lesend (Pflicht, wenn das Ziel die Produktion ist)
E2E_NUR_LESEN=

# Zugangsdaten je Rolle (Test-Konten des Test-Betriebs). Leere Rolle = ihre Tests werden übersprungen.
E2E_TENANT_ADMIN_EMAIL=
E2E_TENANT_ADMIN_PASSWORT=
# Base32-Geheimnis der Authenticator-Einrichtung, nur wenn das Konto 2FA nutzt
E2E_TENANT_ADMIN_TOTP_SECRET=
# Nur bei mehreren Betrieben: aktiver Betrieb
E2E_TENANT_ADMIN_TENANT_ID=

E2E_WINZER_EMAIL=
E2E_WINZER_PASSWORT=
E2E_WINZER_TOTP_SECRET=
E2E_WINZER_TENANT_ID=

E2E_LESER_EMAIL=
E2E_LESER_PASSWORT=
E2E_LESER_TOTP_SECRET=
E2E_LESER_TENANT_ID=

# Mandantentrennung: Datensätze aus einem FREMDEN Betrieb (JSON-Array)
# E2E_FREMDE_IDS=["/crm/kontakte/<uuid>", {"pfad": "/kellerbuch/weinausbau/<uuid>", "text": "<Name nur im fremden Betrieb>"}]
E2E_FREMDE_IDS=

# Modul-Toggles des Test-Betriebs (leer = alle an): modul_ea,modul_sumup,modul_export,modul_controlling
E2E_MODULE=

# Weitere erlaubte Konsolenmeldungen (Regex, mit || getrennt)
E2E_KONSOLE_IGNORIEREN=

# Geschützte Vercel-Previews: „Protection Bypass for Automation“-Secret
E2E_VERCEL_BYPASS=
